.recipes-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recipe-detail {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.recipe-hero-image {
  width: calc(100% + 48rpx);
  height: 320rpx;
  margin: -24rpx -24rpx 22rpx;
}

.recipe-hero-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eef7f0 0%, #f8fbf8 100%);
  color: #32513f;
}

.recipe-hero-fallback-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.recipe-hero-fallback-copy {
  margin-top: 14rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
}

.recipe-name {
  font-size: 34rpx;
  font-weight: 700;
}

.recipe-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a887f;
}

.recipe-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recipe-fav {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff8ee;
  color: #b8a88a;
  font-size: 36rpx;
}

.recipe-fav-active {
  background: #fff4e0;
  color: #f5a623;
}

.recipe-toggle {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f6faf7;
  color: #23a356;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid rgba(35, 163, 86, 0.12);
  margin: 0;
}

.recipe-toggle::after {
  border: none;
}

.share-banner {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #eef7f0;
  color: #2f8f4a;
  font-size: 26rpx;
  line-height: 1.5;
}

.recipe-filter-bar {
  width: 100%;
  white-space: nowrap;
}

.recipe-filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 2rpx 2rpx;
}

.recipe-filter {
  min-width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #607268;
  border: 2rpx solid rgba(47, 74, 58, 0.08);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.recipe-filter-active {
  background: #23a356;
  color: #ffffff;
  border-color: #23a356;
}

.profile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.profile-card {
  width: calc(50% - 7rpx);
  background: #f8fbf8;
  border-radius: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.profile-card-wide {
  width: 100%;
}

.profile-label {
  color: #7a887f;
  font-size: 22rpx;
}

.profile-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d3a2b;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e8f6ec;
  color: #269b57;
  font-size: 22rpx;
}

.profile-tag-soft {
  background: #fff4ea;
  color: #ff6a2c;
}

.detail-block {
  margin-top: 22rpx;
}

.detail-title {
  margin-bottom: 12rpx;
  color: #7a887f;
  font-size: 24rpx;
}

.ingredient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ingredient-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.ingredient-pill-owned {
  background: #edf7ed;
  color: #2f8f4a;
}

.ingredient-pill-missing {
  background: #fff4ea;
  color: #ff6a2c;
}

.seasoning-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f3f0ea;
  color: #6e675e;
}

.advice-row {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f6faf7;
  color: #2f4a3a;
  line-height: 1.7;
  margin-top: 12rpx;
}

.condition-card {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff9f2;
}

.condition-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #c56b1f;
}

.condition-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b584b;
  line-height: 1.7;
}

.step-row {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #faf7f2;
  margin-top: 12rpx;
  line-height: 1.7;
}

.tip-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fff3ec;
  color: #6b584b;
  line-height: 1.7;
}
