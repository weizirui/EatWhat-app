.match-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 20rpx;
}

.setup-required-notice {
  position: relative;
  padding: 20rpx 108rpx 20rpx 22rpx;
  border-left: 6rpx solid #e3a03f;
  border-radius: 12rpx;
  background: #fff9ef;
  box-sizing: border-box;
}

.setup-required-title {
  color: #5f4a2b;
  font-size: 25rpx;
  font-weight: 700;
}

.setup-required-copy {
  margin-top: 6rpx;
  color: #806b4a;
  font-size: 22rpx;
  line-height: 1.5;
}

.setup-required-action {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #1f8f4d;
  font-size: 24rpx;
  font-weight: 700;
}

.share-status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #eef8f1;
  border: 2rpx solid rgba(35, 163, 86, 0.1);
}

.share-status-label {
  color: #5d7a67;
  font-size: 22rpx;
}

.share-status-title {
  margin-top: 6rpx;
  color: #183426;
  font-size: 30rpx;
  font-weight: 700;
}

.share-status-copy {
  margin-top: 6rpx;
  color: #617568;
  font-size: 23rpx;
  line-height: 1.45;
}

.share-status-error {
  color: #b06034;
}

.share-status-action {
  flex-shrink: 0;
  min-width: 150rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #23a356;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  margin: 0;
  padding: 0 22rpx;
}

.recipe-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.recipe-card-compact {
  padding: 22rpx;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.recipe-cover {
  width: calc(100% + 48rpx);
  height: 240rpx;
  margin: -24rpx -24rpx 20rpx;
}

.recipe-cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eef7f0 0%, #f8fbf8 100%);
  color: #32513f;
}

.recipe-cover-fallback-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.recipe-cover-fallback-copy {
  margin-top: 12rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
}

.recipe-head {
  gap: 18rpx;
}

.match-hero-card {
  padding: 20rpx 24rpx;
}

.match-hero-card .title {
  margin-top: 4rpx;
  font-size: 38rpx;
  line-height: 1.18;
}

.match-hero-card .subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.match-focus-card,
.match-summary-card,
.more-recipes-card {
  background: #ffffff;
}

.match-summary-card {
  padding: 18rpx 24rpx;
}

.match-summary-card .subtitle {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.focus-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 18rpx;
}

.focus-row {
  display: inline-flex;
  gap: 12rpx;
}

.focus-chip {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #f6faf7;
  color: #345443;
  font-size: 24rpx;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.focus-chip-active {
  background: #23a356;
  color: #ffffff;
  border: none;
}

.focus-copy {
  margin-top: 16rpx;
}

.match-summary-line {
  margin-top: 8rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.recipe-title {
  font-size: 32rpx;
  font-weight: 700;
}

.recipe-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #78877d;
}

.recipe-priority {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #eef8f1;
  color: #2f8f4a;
  font-size: 24rpx;
  line-height: 1.6;
}

.recipe-badge {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.recipe-badge-ok {
  background: #edf7ed;
  color: #2f8f4a;
}

.recipe-badge-warn {
  background: #fff4ea;
  color: #ff6a2c;
}

.ingredient-card-row {
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(35, 163, 86, 0.06);
}

.ingredient-card-row .recipe-head {
  min-width: 0;
  gap: 12rpx;
}

.ingredient-card-row .recipe-head > view:first-child {
  min-width: 0;
}

.ingredient-card-row .recipe-title {
  font-size: 30rpx;
}

.ingredient-card-row .recipe-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.35;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ingredient-card-row .recipe-badge {
  align-self: center;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
}

.recipe-line {
  margin-top: 18rpx;
  line-height: 1.7;
}

.recipe-label {
  display: inline-block;
  width: 92rpx;
  color: #839187;
  font-size: 24rpx;
}

.recipe-copy {
  font-size: 26rpx;
}

.recipe-actions {
  margin-top: 22rpx;
  display: flex;
  justify-content: flex-end;
}

.recipe-pick {
  min-width: 220rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(35, 163, 86, 0.12);
  background: #f6faf7;
  color: #183426;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.recipe-pick::after {
  border: none;
}

.recipe-pick-active {
  background: #23a356;
  border: none;
  color: #ffffff;
}

.recipe-fill {
  margin-top: 16rpx;
}

.more-recipes-head {
  gap: 18rpx;
}

.more-recipes-list {
  margin-top: 18rpx;
}

.receiver-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.receiver-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.receiver-option {
  min-height: 60rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(47, 74, 58, 0.12);
  border-radius: 14rpx;
  background: #fffdf9;
  color: #617067;
  font-size: 23rpx;
  line-height: 60rpx;
  box-sizing: border-box;
}

.receiver-option-active {
  border-color: #2b7a4b;
  background: #edf7f0;
  color: #1f6a3d;
  font-weight: 700;
}

.receiver-state {
  margin-top: 6rpx;
  color: #7f8d83;
  font-size: 23rpx;
  line-height: 1.6;
}

.receiver-state-error {
  color: #9b5648;
}

.recipe-more-toggle {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #f6faf7;
  color: #23a356;
  font-size: 24rpx;
  font-weight: 700;
}

.form-stack {
  margin-top: 20rpx;
}

.form-row {
  gap: 16rpx;
}

.picker-box {
  flex: 1;
}

.picker-inner {
  line-height: 48rpx;
}

.empty-card {
  text-align: center;
}

.empty-title {
  font-size: 36rpx;
}

.match-bottom-space {
  height: 330rpx;
}

.match-fab {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 22rpx;
  z-index: 30;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(47, 74, 58, 0.06);
  box-shadow: 0 16rpx 44rpx rgba(37, 109, 61, 0.14);
  box-sizing: border-box;
}

.match-fab > button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding-left: 8rpx;
  padding-right: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-fab-submit {
  grid-column: 1 / -1;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  margin: 0;
  padding: 0;
}

.share-banner {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #eef7f0;
  color: #2f8f4a;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
