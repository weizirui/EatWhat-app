<view class="page match-page">
  <view class="card match-hero-card">
    <view class="section-title">已选菜谱</view>
    <view class="title">已经帮你汇总好需要采购的主食材</view>
    <view class="subtitle" wx:if="{{selectedRecipesText}}">今晚想做：{{selectedRecipesText}}</view>
    <view class="subtitle match-summary-line" wx:if="{{purchaseIngredientsText}}">待采购：{{purchaseIngredientsText}}</view>
    <view class="subtitle" wx:if="{{!selectedRecipesText}}">还没有已选菜谱，请返回上一页重新选择。</view>
  </view>

  <view class="stack" wx:if="{{recipeCount || ingredientCount}}">
    <view class="card match-summary-card">
      <view class="section-title">采购清单</view>
      <view class="subtitle">共 {{ingredientCount}} 项主食材，对应 {{recipeCount}} 道菜。</view>
    </view>

    <view wx:for="{{purchaseIngredients}}" wx:key="id" class="recipe-card ingredient-card-row">
      <view class="row-between recipe-head">
        <view>
          <view class="recipe-title">{{item.name}}</view>
          <view class="recipe-meta">用于：{{item.recipeTitlesText}}</view>
        </view>
        <view class="recipe-badge recipe-badge-ok">
          {{item.countText}}
        </view>
      </view>
    </view>

    <view class="card more-recipes-card">
      <view class="row-between more-recipes-head">
        <view>
          <view class="section-title">已选菜谱</view>
          <view class="subtitle">点下面按钮可以继续查看详细做法和营养信息。</view>
        </view>
      </view>

      <view class="stack more-recipes-list">
        <view wx:for="{{selectedRecipes}}" wx:key="id" class="recipe-card recipe-card-compact">
          <view class="row-between recipe-head">
            <view>
              <view class="recipe-title">{{item.title}}</view>
              <view class="recipe-meta">{{item.category}} · {{item.minutes}} 分钟 · {{item.difficulty}}</view>
            </view>
            <view class="recipe-badge recipe-badge-ok">
              已选
            </view>
          </view>
          <view class="recipe-priority">主食材：{{item.ingredientText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section empty-card" wx:else>
    <view class="title empty-title">还没有菜谱</view>
    <view class="subtitle">先回上一页挑几道菜，再来生成采购清单。</view>
  </view>

  <view class="section receiver-section" wx:if="{{recipeCount}}">
    <view class="section-title">这份清单交给谁</view>
    <view class="subtitle">每份清单只指定一位负责人，避免重复采购。</view>
    <view class="receiver-state" wx:if="{{collaboratorsLoading}}">协作人加载中...</view>
    <view class="receiver-state receiver-state-error" wx:elif="{{collaboratorsError}}">{{collaboratorsError}}</view>
    <view class="receiver-options" wx:else>
      <view
        class="{{selectedReceiverOpenid ? 'receiver-option' : 'receiver-option receiver-option-active'}}"
        data-openid=""
        data-name="仅自己保存"
        bindtap="selectReceiver"
      >
        仅自己保存
      </view>
      <view
        wx:for="{{collaborators}}"
        wx:key="partnerOpenid"
        class="{{item.className}}"
        data-openid="{{item.partnerOpenid}}"
        data-name="{{item.partnerName}}"
        bindtap="selectReceiver"
      >
        {{item.partnerName}}
      </view>
    </view>
  </view>

  <view class="match-bottom-space"></view>

  <view wx:if="{{pickedPanelOpen}}" class="picked-mask" bindtap="closePickedPanel"></view>
  <view class="{{pickedPanelClass}}">
    <view class="picked-head row-between">
      <view class="picked-head-title">菜谱详情</view>
      <view class="picked-head-actions">
        <text class="picked-head-close" bindtap="closePickedPanel">收起</text>
      </view>
    </view>

    <scroll-view wx:if="{{pickedTabs.length}}" class="picked-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="picked-tabs-row">
        <view
          wx:for="{{pickedTabs}}"
          wx:key="id"
          class="{{item.className}}"
          data-id="{{item.id}}"
          bindtap="setActivePicked"
        >
          {{item.title}}
        </view>
      </view>
    </scroll-view>

    <scroll-view wx:if="{{activePickedDetail}}" class="picked-body" scroll-y enhanced>
      <view class="picked-meta">
        <view class="picked-meta-title">{{activePickedDetail.title}}</view>
        <view class="picked-meta-sub">{{activePickedDetail.caloriesText}} · {{activePickedDetail.proteinText}}</view>
        <view class="picked-meta-sub">{{activePickedDetail.servingsText}} · {{activePickedDetail.cookingMethod}}</view>
      </view>

      <view class="picked-section" wx:if="{{activePickedDetail.suitableTags.length}}">
        <view class="picked-section-title">适宜人群</view>
        <view class="picked-tags">
          <text
            wx:for="{{activePickedDetail.suitableTags}}"
            wx:key="*this"
            class="picked-tag"
          >
            {{item}}
          </text>
        </view>
      </view>

      <view class="picked-section" wx:if="{{activePickedDetail.swapLines.length}}">
        <view class="picked-section-title">食材替换</view>
        <view wx:for="{{activePickedDetail.swapLines}}" wx:key="id" class="picked-advice">
          {{item.text}}
        </view>
      </view>

      <view class="picked-section" wx:if="{{activePickedDetail.conditionAdvice.length}}">
        <view class="picked-section-title">状态建议</view>
        <view wx:for="{{activePickedDetail.conditionAdvice}}" wx:key="id" class="picked-advice-card">
          <view class="picked-advice-title">{{item.title}}</view>
          <view class="picked-advice-copy">{{item.text}}</view>
        </view>
      </view>

      <view class="picked-section">
        <view class="picked-section-title">主食材用量</view>
        <view wx:for="{{activePickedDetail.ingredientLines}}" wx:key="text" class="picked-line">
          {{item.text}}
        </view>
      </view>

      <view class="picked-section" wx:if="{{activePickedDetail.baseSeasoningLines.length}}">
        <view class="picked-section-title">常备辅料</view>
        <view wx:for="{{activePickedDetail.baseSeasoningLines}}" wx:key="text" class="picked-line">
          {{item.text}}
        </view>
      </view>

      <view class="picked-section">
        <view class="picked-section-title">做法</view>
        <view wx:for="{{activePickedDetail.stepLines}}" wx:key="id" class="picked-step">
          {{item.text}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="match-fab">
    <button
      class="{{recipeCount ? 'match-fab-info match-fab-info-active' : 'match-fab-info'}}"
      bindtap="togglePickedPanel"
    >
      菜谱详情（{{recipeCount}}）
    </button>
    <button class="match-fab-kf" open-type="contact">联系客服</button>
    <button class="btn-primary match-fab-submit" bindtap="submitOrder" disabled="{{submitting}}" loading="{{submitting}}">
      {{submitting ? '提交中...' : '提交清单'}}
    </button>
  </view>
</view>
