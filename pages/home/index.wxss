.home-page {
  position: relative;
}

.market-hero {
  background: linear-gradient(180deg, #f2fff7 0%, #ffffff 100%);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(37, 109, 61, 0.08);
}

.market-hero-top {
  align-items: flex-start;
}

.market-eyebrow {
  color: #23a356;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.market-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #183426;
}

.market-subtitle {
  margin-top: 12rpx;
  color: #6f8276;
  line-height: 1.7;
}

.market-search {
  height: 84rpx;
  border-radius: 999rpx;
  background: #f3f7f4;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.market-search-icon {
  color: #7b8c82;
  margin-right: 16rpx;
}

.market-search-input {
  flex: 1;
}

.market-search-clear {
  color: #23a356;
  font-size: 24rpx;
}

.mini-link {
  font-size: 24rpx;
}

.category-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.ingredient-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ingredient-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 0 20rpx;
  min-height: 320rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(47, 74, 58, 0.06);
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(47, 74, 58, 0.06);
}

.ingredient-card-active {
  background: #ffffff;
  border-color: rgba(35, 163, 86, 0.3);
}

.ingredient-image {
  width: 100%;
  height: 180rpx;
}

.ingredient-image-fallback,
.cart-item-image-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eef7f0 0%, #f8fbf8 100%);
  color: #4f6758;
}

.image-fallback-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.image-fallback-copy {
  margin-top: 10rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.4;
}

.ingredient-top {
  padding: 18rpx 18rpx 0;
}

.ingredient-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #183426;
}

.ingredient-category {
  padding: 10rpx 18rpx 0;
  color: #76867c;
  font-size: 22rpx;
}

.ingredient-tags {
  margin-top: 14rpx;
  padding: 0 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.ingredient-tag {
  display: inline-flex;
  min-height: 40rpx;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #6d7c72;
  font-size: 20rpx;
}

.ingredient-state {
  margin-top: 18rpx;
  padding: 0 18rpx;
  color: #23a356;
  font-size: 24rpx;
  font-weight: 600;
}

.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 24, 18, 0.28);
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -960rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 18rpx 24rpx 180rpx;
  box-sizing: border-box;
  box-shadow: 0 -18rpx 44rpx rgba(18, 42, 28, 0.12);
  transition: bottom 0.22s ease;
  z-index: 19;
}

.cart-sheet-open {
  bottom: 0;
}

.cart-handle {
  width: 88rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d9e3dc;
  margin: 0 auto 18rpx;
}

.cart-head {
  align-items: flex-start;
}

.cart-head-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cart-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #183426;
}

.cart-subtitle {
  margin-top: 10rpx;
  color: #7a897f;
  font-size: 24rpx;
}

.cart-close {
  color: #23a356;
  font-size: 24rpx;
}

.cart-clear {
  color: #ff6a2c;
  font-size: 24rpx;
}

.cart-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 720rpx;
  overflow: auto;
}

.cart-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cart-group-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #183426;
}

.cart-group-title-soft {
  color: #2f8f4a;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f8fbf8;
  border-radius: 24rpx;
  padding: 14rpx;
}

.cart-item-soft {
  background: #f6faf7;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.cart-item-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.cart-ingredient-image {
  background: #f7f2e8;
}

.cart-image-fallback-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.cart-item-copy {
  flex: 1;
  min-width: 0;
}

.cart-item-name {
  color: #183426;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-item-meta {
  margin-top: 8rpx;
  color: #7b8b81;
  font-size: 22rpx;
}

.cart-item-remove {
  color: #ff6a2c;
  font-size: 24rpx;
  flex-shrink: 0;
}

.cart-empty {
  text-align: center;
  padding: 60rpx 24rpx 20rpx;
}

.cart-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #183426;
}

.fab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 50rpx rgba(47, 74, 58, 0.12);
  z-index: 20;
  align-items: center;
}

.fab-summary {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f6faf7;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
  border-radius: 22rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.fab-count {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #23a356;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.fab-copy {
  min-width: 0;
  flex: 1;
}

.fab-title {
  color: #183426;
  font-size: 26rpx;
  font-weight: 700;
}

.fab-desc {
  margin-top: 8rpx;
  color: #7b8b81;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fab-primary {
  width: 248rpx;
  margin: 0;
  flex-shrink: 0;
  height: auto;
  min-height: 92rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  box-sizing: border-box;
  overflow: hidden;
}

.fab-primary::after {
  border: none;
}

.fab-primary-soft {
  background: #f6faf7;
  color: #183426;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.fab-primary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #183426;
}

.fab-primary-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f8276;
}
