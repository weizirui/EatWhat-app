.home-page {
  position: relative;
}

.market-hero {
  background: linear-gradient(180deg, #f2fff7 0%, #ffffff 100%);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(37, 109, 61, 0.08);
}

.market-hero-top {
  align-items: flex-start;
}

.market-eyebrow {
  color: #23a356;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.market-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #183426;
}

.market-subtitle {
  margin-top: 12rpx;
  color: #6f8276;
  line-height: 1.7;
}

.market-search {
  height: 84rpx;
  border-radius: 999rpx;
  background: #f3f7f4;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.market-search-icon {
  color: #7b8c82;
  margin-right: 16rpx;
}

.market-search-input {
  flex: 1;
}

.market-search-clear {
  color: #23a356;
  font-size: 24rpx;
}

.home-fold-card {
  margin-top: 20rpx;
  padding: 0;
  border: 2rpx solid rgba(35, 163, 86, 0.14);
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(47, 74, 58, 0.05);
  overflow: hidden;
}

.home-fold-head {
  min-height: 112rpx;
  padding: 20rpx 22rpx 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.home-fold-head:active {
  background: #f1f8f3;
}

.home-fold-kicker {
  color: #23a356;
  font-size: 20rpx;
  font-weight: 700;
}

.home-fold-title {
  margin-top: 6rpx;
  color: #183426;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.home-fold-sub {
  margin-top: 5rpx;
  color: #718077;
  font-size: 22rpx;
}

.home-fold-arrow {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #23a356;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 54rpx;
  text-align: center;
  flex-shrink: 0;
  transform: rotate(-90deg);
  transition: transform 0.2s ease;
}

.home-fold-arrow-open {
  transform: rotate(0deg);
}

.home-fold-body {
  padding: 0 22rpx 22rpx;
}

.week-plan-entry-button {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #edf8f0;
  color: #20894c;
  font-size: 26rpx;
  font-weight: 700;
}

.week-plan-entry-button::after {
  border: none;
}

.ai-recipe-box {
  border-color: rgba(35, 163, 86, 0.1);
}

.ai-recipe-kicker {
  color: #23a356;
  font-size: 20rpx;
  font-weight: 700;
}

.ai-recipe-title {
  margin-top: 6rpx;
  color: #183426;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ai-recipe-input-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-recipe-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f6faf7;
  color: #183426;
  font-size: 25rpx;
  box-sizing: border-box;
}

.ai-recipe-btn {
  width: 136rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #23a356;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.ai-recipe-error {
  margin-top: 12rpx;
  color: #b06034;
  font-size: 23rpx;
}

.ai-recipe-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-recipe-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fbf8;
  box-sizing: border-box;
}

.ai-recipe-card-body {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.ai-recipe-image {
  width: 118rpx;
  height: 118rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #edf5ef;
}

.ai-recipe-image-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7b8b81;
}

.ai-recipe-image-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.ai-recipe-image-copy {
  width: 100rpx;
  color: #7b8b81;
  font-size: 19rpx;
  line-height: 1.15;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-recipe-card-main {
  flex: 1;
  min-width: 0;
}

.ai-recipe-card-title {
  color: #183426;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.ai-recipe-card-meta,
.ai-recipe-card-ingredients {
  margin-top: 6rpx;
  color: #728177;
  font-size: 23rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-recipe-action {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #edf8f0;
  color: #20894c;
  font-size: 25rpx;
  font-weight: 700;
}

.ai-recipe-action-active {
  background: #23a356;
  color: #ffffff;
}

.category-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-controls {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.category-result {
  margin-top: 8rpx;
  color: #76867c;
  font-size: 22rpx;
}

.category-picker-wrap {
  flex: 1;
  min-width: 0;
}

.category-picker {
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx 0 22rpx;
  border: 2rpx solid rgba(35, 163, 86, 0.16);
  border-radius: 16rpx;
  background: #f6faf7;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.category-picker-value {
  min-width: 0;
  color: #183426;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.category-picker-arrow {
  color: #23a356;
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}

.favorites-filter {
  width: 220rpx;
  height: 76rpx;
  padding: 0 14rpx;
  border: 2rpx solid rgba(47, 74, 58, 0.09);
  border-radius: 16rpx;
  background: #ffffff;
  color: #516359;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.favorites-filter-active {
  border-color: rgba(35, 163, 86, 0.28);
  background: #edf8f0;
  color: #1f8549;
}

.favorites-filter-pressed {
  background: #e5f3e9;
}

.favorites-filter-icon {
  font-size: 28rpx;
  line-height: 1;
}

.favorites-filter-text {
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.favorites-filter-count {
  min-width: 30rpx;
  color: #7a887f;
  font-size: 20rpx;
  text-align: center;
}

.ingredient-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ingredient-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 0 20rpx;
  min-height: 320rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(47, 74, 58, 0.06);
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(47, 74, 58, 0.06);
  display: flex;
  flex-direction: column;
}

.ingredient-card-active {
  background: #ffffff;
  border-color: rgba(35, 163, 86, 0.3);
}

.ingredient-image {
  width: 100%;
  height: 180rpx;
}

.ingredient-image-fallback,
.cart-item-image-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eef7f0 0%, #f8fbf8 100%);
  color: #4f6758;
}

.image-fallback-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.image-fallback-copy {
  margin-top: 10rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.4;
}

.ingredient-top {
  padding: 18rpx 18rpx 0;
}

.ingredient-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #183426;
}

.ingredient-category {
  padding: 10rpx 18rpx 0;
  color: #76867c;
  font-size: 22rpx;
}

.ingredient-tags {
  margin-top: 14rpx;
  padding: 0 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.ingredient-tag {
  display: inline-flex;
  min-height: 40rpx;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #6d7c72;
  font-size: 20rpx;
}

.ingredient-actions {
  margin-top: auto;
  padding: 18rpx 18rpx 0;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.ingredient-action {
  flex: 1 1 0;
  min-width: 0;
  height: 54rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
  font-size: 19rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
}

.ingredient-action-add {
  background: #edf8f0;
  color: #20894c;
}

.ingredient-action-active {
  background: #23a356;
  color: #ffffff;
}

.ingredient-action-favorite {
  border: 2rpx solid rgba(47, 74, 58, 0.09);
  background: #ffffff;
  color: #69786f;
}

.ingredient-action-favorite-active {
  border-color: rgba(194, 79, 78, 0.18);
  background: #fff2f1;
  color: #b94d4d;
}

.ingredient-action-icon {
  font-size: 22rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ingredient-action-label {
  min-width: 0;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}

.favorites-empty {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  border: 2rpx dashed rgba(47, 74, 58, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.62);
  text-align: center;
}

.favorites-empty-title {
  color: #2f4a3a;
  font-size: 28rpx;
  font-weight: 700;
}

.favorites-empty-copy {
  margin-top: 10rpx;
  color: #7a887f;
  font-size: 22rpx;
}

.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 24, 18, 0.28);
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -960rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 18rpx 24rpx 180rpx;
  box-sizing: border-box;
  box-shadow: 0 -18rpx 44rpx rgba(18, 42, 28, 0.12);
  transition: bottom 0.22s ease;
  z-index: 19;
}

.cart-sheet-open {
  bottom: 0;
}

.cart-handle {
  width: 88rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d9e3dc;
  margin: 0 auto 18rpx;
}

.cart-head {
  align-items: flex-start;
}

.cart-head-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cart-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #183426;
}

.cart-subtitle {
  margin-top: 10rpx;
  color: #7a897f;
  font-size: 24rpx;
}

.cart-close {
  color: #23a356;
  font-size: 24rpx;
}

.cart-clear {
  color: #ff6a2c;
  font-size: 24rpx;
}

.cart-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 720rpx;
  overflow: auto;
}

.cart-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cart-group-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #183426;
}

.cart-group-title-soft {
  color: #2f8f4a;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f8fbf8;
  border-radius: 24rpx;
  padding: 14rpx;
}

.cart-item-soft {
  background: #f6faf7;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.cart-item-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.cart-ingredient-image {
  background: #f7f2e8;
}

.cart-image-fallback-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.cart-item-copy {
  flex: 1;
  min-width: 0;
}

.cart-item-name {
  color: #183426;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-item-meta {
  margin-top: 8rpx;
  color: #7b8b81;
  font-size: 22rpx;
}

.cart-item-remove {
  color: #ff6a2c;
  font-size: 24rpx;
  flex-shrink: 0;
}

.cart-empty {
  text-align: center;
  padding: 60rpx 24rpx 20rpx;
}

.cart-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #183426;
}

.fab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 50rpx rgba(47, 74, 58, 0.12);
  z-index: 20;
  align-items: center;
}

.fab-summary {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f6faf7;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
  border-radius: 22rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.fab-count {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #23a356;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.fab-copy {
  min-width: 0;
  flex: 1;
}

.fab-title {
  color: #183426;
  font-size: 26rpx;
  font-weight: 700;
}

.fab-desc {
  margin-top: 8rpx;
  color: #7b8b81;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fab-primary {
  width: 248rpx;
  margin: 0;
  flex-shrink: 0;
  height: auto;
  min-height: 92rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  box-sizing: border-box;
  overflow: hidden;
}

.fab-primary::after {
  border: none;
}

.fab-primary-soft {
  background: #f6faf7;
  color: #183426;
  border: 2rpx solid rgba(35, 163, 86, 0.08);
}

.fab-primary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #183426;
}

.fab-primary-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f8276;
}
