.plan-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 48rpx;
}

.plan-hero {
  margin: 0 -24rpx 8rpx;
  padding: 40rpx 32rpx 34rpx;
  background: #183426;
  color: #ffffff;
}

.plan-hero-kicker {
  color: #8de3ac;
  font-size: 22rpx;
  font-weight: 700;
}

.plan-hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.plan-hero-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
}

.plan-hero-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 1.5;
}

.plan-hero-actions {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.plan-week-btn,
.plan-refresh-btn {
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-weight: 700;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.plan-week-btn {
  flex: 1 1 auto;
  min-width: 0;
  background: #ffffff;
  color: #183426;
  font-size: 25rpx;
}

.plan-refresh-btn {
  width: 80rpx;
  min-width: 80rpx;
  flex: 0 0 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 36rpx;
}

.plan-week-btn-pressed {
  background: #eef8f1;
}

.plan-refresh-btn-pressed {
  background: rgba(255, 255, 255, 0.2);
}

.plan-week-btn::after,
.plan-refresh-btn::after,
.plan-add-btn::after {
  border: 0;
}

.plan-state {
  padding: 48rpx 0;
  text-align: center;
  color: #7a887f;
  font-size: 26rpx;
}

.plan-day {
  overflow: hidden;
  border: 2rpx solid rgba(47, 74, 58, 0.08);
  border-radius: 16rpx;
  background: #ffffff;
}

.plan-day-open {
  border-color: rgba(35, 163, 86, 0.2);
}

.plan-day-head {
  min-height: 104rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.plan-day-date-block {
  width: 126rpx;
  flex-shrink: 0;
}

.plan-day-weekday {
  font-size: 28rpx;
  font-weight: 800;
  color: #183426;
}

.plan-day-date {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #7a887f;
}

.plan-day-summary {
  flex: 1;
  min-width: 0;
  color: #3f5b49;
  font-size: 23rpx;
}

.plan-day-ingredients {
  margin-top: 4rpx;
  color: #8a978e;
  font-size: 21rpx;
}

.plan-day-arrow {
  width: 44rpx;
  color: #23a356;
  font-size: 28rpx;
  text-align: center;
  flex-shrink: 0;
}

.plan-day-body {
  padding: 0 20rpx 22rpx;
  border-top: 2rpx solid rgba(47, 74, 58, 0.06);
}

.plan-meal {
  padding: 22rpx 0 18rpx;
  border-bottom: 2rpx solid rgba(47, 74, 58, 0.06);
}

.plan-meal-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.plan-meal-name {
  padding-left: 12rpx;
  border-left: 6rpx solid #23a356;
  color: #183426;
  font-size: 25rpx;
  font-weight: 800;
}

.plan-meal-hint {
  min-width: 0;
  color: #89958d;
  font-size: 20rpx;
}

.plan-recipe-list {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.plan-recipe-row {
  min-height: 92rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f7faf7;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.plan-recipe-emoji {
  font-size: 30rpx;
  flex-shrink: 0;
}

.plan-recipe-copy {
  min-width: 0;
}

.plan-recipe-title {
  color: #2f4a3a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.plan-recipe-meta {
  margin-top: 5rpx;
  color: #8a978e;
  font-size: 18rpx;
  line-height: 1.3;
}

.plan-add-btn {
  width: 100%;
  height: 78rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #23a356;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 78rpx;
}
