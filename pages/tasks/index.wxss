.tasks-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.task-tab {
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(47, 74, 58, 0.1);
  border-radius: 16rpx;
  background: #fffdf9;
  color: #6d7b72;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.task-tab-active {
  border-color: #2b7a4b;
  background: #edf7f0;
  color: #1f6a3d;
  font-weight: 700;
}

.task-tab-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: rgba(31, 106, 61, 0.1);
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.task-state {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(47, 74, 58, 0.08);
  border-radius: 16rpx;
  background: #fffdf9;
  color: #7f8d83;
  font-size: 24rpx;
  line-height: 1.6;
}

.task-state-error {
  color: #a34a3d;
}

.task-retry {
  min-height: 68rpx;
  height: 68rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}

.task-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  padding: 24rpx;
  border: 2rpx solid rgba(47, 74, 58, 0.08);
  border-radius: 16rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.task-card-head {
  gap: 16rpx;
}

.task-order-id {
  min-width: 0;
  color: #2f4a3a;
  font-size: 27rpx;
  font-weight: 700;
  word-break: break-all;
}

.task-head-badges {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.task-unread,
.task-status {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  line-height: 42rpx;
}

.task-unread {
  background: #fff0df;
  color: #a45322;
}

.task-status {
  background: #edf7f0;
  color: #1f6a3d;
}

.task-peer {
  margin-top: 10rpx;
  color: #758179;
  font-size: 23rpx;
}

.task-line {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: start;
}

.task-label {
  color: #8b948d;
  font-size: 23rpx;
}

.task-value {
  color: #43544a;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.task-time {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(47, 74, 58, 0.06);
  color: #969e98;
  font-size: 21rpx;
}

.task-action {
  width: 100%;
  min-height: 68rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}
