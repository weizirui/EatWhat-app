<view class="page landing-page">
  <view class="pu-header">
    <view class="pu-top row-between">
      <view>
        <view class="pu-location">今天吃什么 · 轻松选菜</view>
        <view class="pu-location-sub">一日三餐随心选，采购清单自动整理</view>
      </view>
      <view class="pu-avatar">鲜</view>
    </view>
  </view>

  <view class="pu-banner">
    <view class="pu-banner-copy">
        <view class="pu-badge">本周计划</view>
        <view class="pu-banner-title">{{plan.headline}}</view>
        <view class="pu-banner-text">{{plan.description}}</view>
        <view class="pu-banner-actions">
        <button class="btn-primary pu-banner-btn" bindtap="goHome">去选菜谱</button>
        </view>
      </view>
  </view>

  <view class="section pu-section">
    <view class="row-between">
      <view class="section-title">{{plan.title}}</view>
      <text class="muted pu-section-note">{{plan.subtitle}}</text>
    </view>
    <view class="pu-grid-list">
      <view
        wx:for="{{fatLossRecipes}}"
        wx:key="id"
        class="pu-grid-card pu-season-card"
        data-id="{{item.id}}"
        data-ingredient-ids="{{item.ingredientIds}}"
        bindtap="pickRecipe"
      >
        <image
          wx:if="{{item.hasImage && !item.imageFailed}}"
          class="pu-grid-image"
          src="{{item.image}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="handleFatLossImageError"
        />
        <view wx:else class="pu-grid-image pu-image-fallback">
          <view class="pu-image-fallback-emoji">{{item.emoji}}</view>
          <view class="pu-image-fallback-copy">{{item.title}}</view>
        </view>
        <view class="pu-grid-body">
          <view class="pu-grid-title">{{item.title}}</view>
          <view class="pu-grid-sub">{{item.subtitle}}</view>
          <view class="pu-grid-cta">一键生成采购清单</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section pu-section">
    <view class="row-between">
      <view class="section-title">今日汤品</view>
      <text class="muted">想喝点热乎的就从这里选</text>
    </view>
    <view class="pu-grid-list">
      <view
        wx:for="{{soupRecipes}}"
        wx:key="id"
        class="pu-grid-card pu-soup-card"
        data-id="{{item.id}}"
        data-ingredient-ids="{{item.ingredientIds}}"
        bindtap="pickRecipe"
      >
        <image
          wx:if="{{item.hasImage && !item.imageFailed}}"
          class="pu-grid-image"
          src="{{item.image}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="handleSoupImageError"
        />
        <view wx:else class="pu-grid-image pu-image-fallback">
          <view class="pu-image-fallback-emoji">{{item.emoji}}</view>
          <view class="pu-image-fallback-copy">{{item.title}}</view>
        </view>
        <view class="pu-grid-body">
          <view class="pu-grid-title">{{item.title}}</view>
          <view class="pu-grid-sub">{{item.subtitle}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section pu-section" wx:if="{{smartSuggestion}}">
    <view class="row-between">
      <view class="section-title">帮你补一道</view>
      <text class="muted">{{smartSuggestion.hint}}</text>
    </view>
    <view class="pu-smart-card" data-id="{{smartSuggestion.id}}" bindtap="pickSmart">
      <image
        wx:if="{{smartSuggestion.hasImage && !smartSuggestion.imageFailed}}"
        class="pu-smart-image"
        src="{{smartSuggestion.image}}"
        mode="aspectFit"
        data-id="{{smartSuggestion.id}}"
        binderror="handleSmartImageError"
      />
      <view wx:else class="pu-smart-image pu-image-fallback">
        <view class="pu-image-fallback-emoji">{{smartSuggestion.emoji}}</view>
      </view>
      <view class="pu-smart-body">
        <view class="pu-smart-title">{{smartSuggestion.title}}</view>
        <view class="pu-smart-sub">{{smartSuggestion.subtitle}}</view>
        <view class="pu-grid-cta">加入采购清单</view>
      </view>
    </view>
  </view>

  <view class="section pu-section" wx:if="{{frequentRecipes.length}}">
    <view class="row-between">
      <view class="section-title">常吃菜</view>
      <text class="muted">家里常做的，一键再加</text>
    </view>
    <view class="pu-frequent-grid">
      <view
        wx:for="{{frequentRecipes}}"
        wx:key="id"
        class="pu-frequent-card"
        hover-class="pu-frequent-card-pressed"
        data-id="{{item.id}}"
        bindtap="pickFrequent"
      >
        <image
          wx:if="{{item.hasImage && !item.imageFailed}}"
          class="pu-frequent-image"
          src="{{item.image}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="handleFrequentImageError"
        />
        <view wx:else class="pu-frequent-image pu-image-fallback">
          <view class="pu-image-fallback-emoji">{{item.emoji}}</view>
        </view>
        <view class="pu-frequent-copy">
          <view class="pu-frequent-title">{{item.title}}</view>
          <view class="pu-frequent-meta">{{item.subtitle}}</view>
        </view>
        <view class="pu-frequent-add" aria-label="加入采购清单">+</view>
      </view>
    </view>
  </view>

  <view class="section pu-section">
    <view class="section-title">怎么使用</view>
    <view class="step-list">
      <view class="step-item">
        <view class="step-index">1</view>
        <view class="step-copy">
          <view class="step-title">先挑今晚想做的菜</view>
          <view class="muted">真实图片 + 分类浏览，选菜速度更快。</view>
        </view>
      </view>
      <view class="step-item">
        <view class="step-index">2</view>
        <view class="step-copy">
          <view class="step-title">自动整理出主食材清单</view>
          <view class="muted">少掉手工整理采购项这一步，清单会自动汇总。</view>
        </view>
      </view>
      <view class="step-item">
        <view class="step-index">3</view>
        <view class="step-copy">
          <view class="step-title">核对清单后直接提交</view>
          <view class="muted">提交后还能继续查看详细做法，买菜和做菜连在一起。</view>
        </view>
      </view>
    </view>
  </view>

</view>
